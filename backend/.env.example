APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# OpenSky Network OAuth2 client_credentials
# https://opensky-network.org/data/api
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISStream WebSocket API key
# https://aisstream.io
AISSTREAM_API_KEY=

# On-board ML models (xgb.pkl, isoforest.pkl) live here. Person C drops
# .pkl files into this directory during the hackathon; the backend loads
# them lazily on first request and falls back to a heuristic if missing.
MODEL_DIR=../ml/models

# Voice alert TTS. Set to false to skip piper-tts and always serve the
# pre-recorded backup MP3s from app/data/voice_backup/.
TTS_ENABLED=true
