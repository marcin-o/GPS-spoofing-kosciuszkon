# Backend (FastAPI). Owned by Person B. Default for local dev.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Mapbox access token. URL-restrict on https://account.mapbox.com before pushing real tokens.
NEXT_PUBLIC_MAPBOX_TOKEN=

# WebSocket URL for /ws/alerts. Leave blank to fall back to polling-only.
NEXT_PUBLIC_WS_URL=

# When "true", boot MSW in the browser and serve mocked API. Use during early hours
# while backend is not yet up. Set to anything else (or unset) to hit the real API.
NEXT_PUBLIC_USE_MSW=true
